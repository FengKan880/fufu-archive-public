# Copy to .env for local use; do not commit your actual .env.
FUFU_ARCHIVE_DB_PATH=data/fufu_archive.db
FUFU_ARCHIVE_HOST=127.0.0.1
FUFU_ARCHIVE_PORT=8000

# Required to access /kb/* endpoints. Use a long random value in real deployments.
FUFU_ARCHIVE_API_TOKEN=replace-with-a-long-random-token

# Optional vector retrieval (P1). Dense/hybrid modes call this backend to embed
# queries and chunks; when unreachable the service gracefully degrades to FTS5.
FUFU_ARCHIVE_EMBED_URL=http://127.0.0.1:11434
FUFU_ARCHIVE_EMBED_MODEL=qwen3-embedding:0.6b
FUFU_ARCHIVE_EMBED_DIM=1024
# Optional semantic extraction. Disabled when provider is empty.
# DEEPSEEK_API_KEY must be supplied by the runtime environment, never committed.
FUFU_ARCHIVE_SEMANTIC_PROVIDER=
FUFU_ARCHIVE_SEMANTIC_MODEL=deepseek-v4-flash
